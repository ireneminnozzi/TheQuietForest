<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130957.controller.MenuController" style="-fx-background-color: #1a1a2e;">
    <children>
        <Label text="The Quiet Forest" textFill="#2d5a27">
            <font>
                <Font name="System Bold" size="48.0" />
            </font>
        </Label>
        <Label text="Un'avventura magica nel bosco" textFill="#aaaaaa">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <VBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="btnNewGame" mnemonicParsing="false" onAction="#handleNewGame" prefWidth="250.0" prefHeight="50.0" text="Nuova Partita" style="-fx-font-size: 16px;" />
                <Button fx:id="btnLoadGame" mnemonicParsing="false" onAction="#handleLoadGame" prefWidth="250.0" prefHeight="50.0" text="Carica Partita" style="-fx-font-size: 16px;" />
                <Button fx:id="btnExit" mnemonicParsing="false" onAction="#handleExit" prefWidth="250.0" prefHeight="50.0" text="Esci" style="-fx-font-size: 16px;" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
</VBox>