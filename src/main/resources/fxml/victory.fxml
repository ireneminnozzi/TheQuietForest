<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="30.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unicam.cs.mpgc.rpg130957.controller.VictoryController" style="-fx-background-color: #1a1a2e; -fx-padding: 40;">
    <children>
        <Label text=" VITTORIA! " textFill="#ffd700">
            <font><Font name="System Bold" size="48.0" /></font>
        </Label>

        <Label text="Hai sconfitto tutti i mostri del bosco!" textFill="#ffffff">
            <font><Font size="22.0" /></font>
        </Label>

        <Label text="La strega ha riportato la pace nella foresta." textFill="#aaaaaa">
            <font><Font size="18.0" /></font>
        </Label>

        <VBox alignment="CENTER" spacing="15.0" style="-fx-padding: 20;">
            <Button fx:id="btnMainMenu" mnemonicParsing="false" onAction="#handleMainMenu" prefWidth="250.0" prefHeight="50.0" text="Torna al Menu Principale" style="-fx-font-size: 16px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Button fx:id="btnExit" mnemonicParsing="false" onAction="#handleExit" prefWidth="250.0" prefHeight="50.0" text="Esci dal Gioco" style="-fx-font-size: 16px; -fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" />
        </VBox>
    </children>
</VBox>